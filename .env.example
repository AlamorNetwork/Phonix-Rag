# --- Database ---
POSTGRES_USER=phoenix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phoenix_forge
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://phoenix:change-me@localhost:5432/phoenix_forge

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Model Provider: Liara AI Gateway (OpenAI-compatible) ---
# LIARA_BASE_URL must include your AI service id, exactly as shown on the service's page in
# the Liara console: https://ai.liara.ir/api/v1/<AI_SERVICE_ID>
# (the id in the API key's JWT is the *key* id, not the service id - they are different).
# The model catalogue is public at https://ai.liara.ir/v1/models
LIARA_API_KEY=
LIARA_BASE_URL=https://ai.liara.ir/api/v1/REPLACE_WITH_AI_SERVICE_ID
LIARA_DEFAULT_MODEL=openai/gpt-4.1-mini
# Per-request ceiling. A premium reasoning model planning a project can think for minutes.
PROVIDER_TIMEOUT_SECONDS=300

# --- Workspaces & sandbox ---
WORKSPACES_DIR=./workspaces
# "docker" runs agent commands in a throwaway, network-less container; "host" only restricts
# which paths a cooperative tool may touch. Tools that execute code refuse to run in host
# mode rather than quietly falling back, so leave this on docker outside development.
# Note: docker mode requires the backend to reach the Docker daemon, which is equivalent to
# root on this host - see the deployment notes in README before enabling it in production.
SANDBOX_MODE=docker
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=128
SANDBOX_NETWORK=none
SANDBOX_TIMEOUT_SECONDS=120
# Empty under a rootless daemon: container uid 0 already maps to an unprivileged host user.
SANDBOX_USER=
# The ROOTLESS daemon socket on the host. Pointing this at the rootful socket would make a
# backend compromise equal to root on the host - the whole reason rootless is used here.
SANDBOX_DOCKER_SOCK=/run/user/1000/docker.sock
SANDBOX_DOCKER_HOST=unix:///var/run/sandbox-docker.sock

# --- Ports (for docker-compose) ---
# backend/frontend are only bound to 127.0.0.1 on the host (debug access via SSH tunnel);
# nginx is the only container exposed on the public interface.
BACKEND_PORT=8000
FRONTEND_PORT=3000
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

# --- Frontend ---
# Baked into the Next.js build at image build time. Point these at whatever the browser
# will actually use to reach nginx: http://<server-ip-or-domain> for a real deployment,
# http://localhost:8000 for local dev without nginx in front.
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:8000
