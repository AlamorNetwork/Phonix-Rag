# --- Database ---
POSTGRES_USER=phoenix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phoenix_forge
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://phoenix:change-me@localhost:5432/phoenix_forge

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Model Provider: Liara AI Gateway (OpenAI-compatible) ---
LIARA_API_KEY=
LIARA_BASE_URL=https://ai.liara.ir/api/v1
LIARA_DEFAULT_MODEL=openai/gpt-4o-mini

# --- Workspaces (sandboxed per-project working dirs) ---
WORKSPACES_DIR=./workspaces

# --- Ports (for docker-compose) ---
# backend/frontend are only bound to 127.0.0.1 on the host (debug access via SSH tunnel);
# nginx is the only container exposed on the public interface.
BACKEND_PORT=8000
FRONTEND_PORT=3000
PUBLIC_HTTP_PORT=80

# --- Frontend ---
# Baked into the Next.js build at image build time. Point these at whatever the browser
# will actually use to reach nginx: http://<server-ip-or-domain> for a real deployment,
# http://localhost:8000 for local dev without nginx in front.
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:8000
